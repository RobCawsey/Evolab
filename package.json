{
  "name": "evolab",
  "private": true,
  "version": "0.0.0",
  "description": "Design bipedal robots, evolve their walking gaits with a genetic algorithm",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @evolab/web",
    "build": "npm run build --workspace @evolab/web",
    "check": "tsc --noEmit -p tsconfig.json",
    "sim": "node --experimental-strip-types scripts/headless.ts",
    "test": "vitest run",
    "evolve": "node --experimental-strip-types scripts/evolve.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
